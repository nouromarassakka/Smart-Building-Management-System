    {
        "id": "func_pegasus_processor",
        "type": "function",
        "z": "5203f3bba624e776",
        "name": "Pegasus Payload Processor",
        "func": "var topic = msg.topic;\nvar payload = msg.payload;\n\n// Handle string vs JSON object payloads\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch(e) {}\n}\n\nvar msgTemp = null;\nvar msgHum = null;\nvar msgLight = null;\nvar msgMotion = null;\nvar msgSmoke = null;\nvar msgHealth = null;\nvar msgAvail = null;\nvar dbMsgs = [];\n\n// Handle Combined Telemetry Payload\nif (topic === 'building/telemetry' && typeof payload === 'object') {\n    if (payload.temperature !== undefined) {\n        msgTemp = { payload: payload.temperature };\n        dbMsgs.push({ topic: \"INSERT INTO Sensors (sensor_name, value) VALUES ('temperature', \" + payload.temperature + \");\" });\n    }\n    if (payload.humidity !== undefined) {\n        msgHum = { payload: payload.humidity };\n        dbMsgs.push({ topic: \"INSERT INTO Sensors (sensor_name, value) VALUES ('humidity', \" + payload.humidity + \");\" });\n    }\n    if (payload.light !== undefined) {\n        msgLight = { payload: payload.light };\n        dbMsgs.push({ topic: \"INSERT INTO Sensors (sensor_name, value) VALUES ('light', \" + payload.light + \");\" });\n    }\n    if (payload.motion !== undefined) {\n        msgMotion = { payload: payload.motion };\n        dbMsgs.push({ topic: \"INSERT INTO Sensors (sensor_name, value) VALUES ('motion', \" + payload.motion + \");\" });\n    }\n    if (payload.smoke !== undefined) {\n        msgSmoke = { payload: payload.smoke };\n        dbMsgs.push({ topic: \"INSERT INTO Sensors (sensor_name, value) VALUES ('smoke', \" + payload.smoke + \");\" });\n    }\n}\n// Handle Individual Topics\nelse if (topic === 'building/temperature') {\n    msgTemp = { payload: parseFloat(payload) };\n} else if (topic === 'building/humidity') {\n    msgHum = { payload: parseFloat(payload) };\n} else if (topic === 'building/health') {\n    msgHealth = { payload: parseInt(payload) };\n} else if (topic === 'building/availability') {\n    msgAvail = { payload: String(payload) };\n}\n\nreturn [\n    msgTemp, msgHum, msgLight, msgMotion, msgSmoke, msgHealth, msgAvail, dbMsgs\n];",
        "outputs": 8,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1080,
        "y": 220,
        "wires": [
